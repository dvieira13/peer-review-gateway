{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npm --prefix assignment-2/functional-codebase run typecheck)",
      "Bash(npm --prefix assignment-2/functional-codebase test)",
      "Bash(npm --prefix assignment-2/functional-codebase run build)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "PowerShell(npm --prefix assignment-2/functional-codebase run typecheck)",
      "PowerShell(npm --prefix assignment-2/functional-codebase test)",
      "PowerShell(npm --prefix assignment-2/functional-codebase run build)"
    ],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Read(./.env)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(curl *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)"
    ]
  },
  "model": "claude-opus-5-5",
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/log-session.mjs --hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
